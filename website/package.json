{
  "name": "minimal-spec-template",
  "version": "1.0.0",
  "description": "极简规范文档模板：构建期 SSG 多页静态站点（Vite + marked + MathJax），运行时零渲染成本、无框架",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "verify:browser": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.3.0",
    "dompurify": "^3.4.13",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.9",
    "marked-alert": "^2.1.2",
    "marked-emoji": "^2.0.3",
    "marked-footnote": "^1.4.0",
    "marked-highlight": "^2.2.4",
    "marked-smartypants": "^1.1.12",
    "mathjax": "^4.1.3",
    "web-computer-modern": "1.1.0-new-cm-7-0-2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
